# ===========================================
# SCRAPER CONFIGURATION v2.0
# ===========================================

# Server Configuration
PORT=3000
NODE_ENV=development
API_VERSION=v1
CORS_ORIGIN=*
MAX_REQUEST_SIZE=10mb

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ===========================================
# SCRAPING CONFIGURATION
# ===========================================

# Timeout settings (in milliseconds)
SCRAPE_TIMEOUT_MS=30000
PROXY_TIMEOUT_MS=10000

# Rate limiting
RATE_LIMIT_PER_SECOND=1

# Maximum retry attempts
MAX_ATTEMPTS=100

# Default behavior flags
DEFAULT_RENDER_JS=false
DEFAULT_BYPASS=true
DEFAULT_STEALTH=true

# ===========================================
# BROWSER CONFIGURATION (Playwright)
# ===========================================
BROWSER_HEADLESS=true
DEFAULT_VIEWPORT_WIDTH=1920
DEFAULT_VIEWPORT_HEIGHT=1080
BROWSER_SLOW_MO=0

# Resource blocking (speeds up scraping)
BLOCK_IMAGES=true
BLOCK_CSS=false
BLOCK_FONTS=true

# ===========================================
# PROXY CONFIGURATION
# ===========================================

# Default provider: free, residential, datacenter
DEFAULT_PROXY_PROVIDER=free

# Residential proxy API (Bright Data, Smartproxy, etc.)
RESIDENTIAL_PROXY_API_KEY=
RESIDENTIAL_PROXY_API_URL=
RESIDENTIAL_PROXY_COUNTRY=US

# Health check interval (ms)
PROXY_HEALTH_CHECK_INTERVAL=60000
MAX_PROXY_FAILURES=3

# ===========================================
# CAPTCHA CONFIGURATION
# ===========================================

# Enable CAPTCHA solving
CAPTCHA_ENABLED=false

# Provider: 2captcha, anticaptcha, capmonster
CAPTCHA_PROVIDER=2captcha
CAPTCHA_API_KEY=
CAPTCHA_TIMEOUT=120000

# ===========================================
# SESSION CONFIGURATION
# ===========================================

# Enable session management
SESSION_ENABLED=false

# Session duration (ms) - default 1 hour
SESSION_MAX_AGE=3600000

# Cleanup interval (ms) - default 5 minutes
SESSION_CLEANUP_INTERVAL=300000

# ===========================================
# QUEUE CONFIGURATION (BullMQ)
# ===========================================

# Enable distributed queue
QUEUE_ENABLED=false

# Worker concurrency
QUEUE_CONCURRENCY=5

# Maximum jobs per worker per minute
MAX_JOBS_PER_WORKER=100

# Job timeout (ms)
JOB_TIMEOUT=60000

# Retry settings
RETRY_ATTEMPTS=3
RETRY_DELAY=5000

# ===========================================
# MONITORING CONFIGURATION
# ===========================================

# Enable monitoring
MONITORING_ENABLED=true

# Metrics flush interval (ms)
METRICS_INTERVAL=10000

# Alert thresholds
ALERT_ERROR_RATE=0.1
ALERT_RESPONSE_TIME=30000
ALERT_QUEUE_SIZE=1000

# ===========================================
# ADVANCED RATE LIMITING
# ===========================================

# Default requests per second
DEFAULT_REQUESTS_PER_SECOND=1

# Burst limit (additional requests allowed)
BURST_LIMIT=5

# Rate limit window (ms)
RATE_LIMIT_WINDOW_MS=1000

# Enable adaptive rate limiting
ENABLE_ADAPTIVE_RATE_LIMIT=false

# Delay range (ms)
MIN_DELAY_MS=500
MAX_DELAY_MS=10000

# ===========================================
# DATACENTER PROXIES (Optional)
# ===========================================
# JSON array of proxy objects
# Example: [{"ip":"1.2.3.4","port":8080,"protocol":"http"}]
DATACENTER_PROXY_LIST=
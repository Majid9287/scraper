{
  "name": "rate-limiting-scraper",
  "version": "2.0.0",
  "description": "Industry-level Node.js Express TypeScript application for anti-detection web scraping with Playwright",
  "main": "dist/setup.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/setup.ts",
    "build": "tsc",
    "start": "node dist/setup.js",
    "postinstall": "npx playwright install chromium",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:docker": "docker-compose run --rm test",
    "test:docker:coverage": "docker-compose run --rm test npm run test:coverage",
    "docker:build": "docker-compose build",
    "docker:dev": "docker-compose up --build",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up --build",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "worker": "node dist/worker.js",
    "worker:dev": "ts-node-dev --respawn --transpile-only src/worker.ts"
  },
  "dependencies": {
    "@types/compression": "^1.8.1",
    "@types/uuid": "^9.0.7",
    "axios": "^1.11.0",
    "bullmq": "^5.1.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5.1.0",
    "playwright": "^1.40.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "redis": "^4.6.10",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.4",
    "jest": "^30.1.3",
    "ts-jest": "^29.4.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
